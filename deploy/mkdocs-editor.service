[Unit]
Description=MkDocs 文档网页编辑器（md-editor-v3）
After=network.target

[Service]
Type=simple
User=mkdocs
Group=docs
Environment=DOCS_DIR=/srv/mkdocs/repo/docs
Environment=DIST_DIR=/srv/mkdocs/editor-app/dist
Environment=EDITOR_PORT=8080
Environment=REPO_OWNER=rainayom
Environment=REPO_NAME=RainAYOM.github.io
ExecStart=/usr/bin/python3 /srv/mkdocs/editor_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
