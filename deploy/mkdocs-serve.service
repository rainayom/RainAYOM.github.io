[Unit]
Description=MkDocs Material 文档服务 (0.0.0.0:8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mkdocs
Group=docs
WorkingDirectory=/srv/mkdocs/repo
Environment=NO_MKDOCS_2_WARNING=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/mkdocs
ExecStart=/srv/mkdocs/.venv/bin/python -m mkdocs serve -a 0.0.0.0:8000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

# 最小权限沙箱
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/mkdocs/repo
ReadOnlyPaths=/srv/mkdocs/.venv
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
